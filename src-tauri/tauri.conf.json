{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WINAPK",
  "mainBinaryName": "WINAPK",
  "version": "0.1.0",
  "identifier": "app.droidwin.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "WINAPK",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#05070A",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "resources": ["resources/scrcpy/**/*"],
    "fileAssociations": [
      {
        "ext": ["apk"],
        "name": "Android package",
        "description": "Android application package",
        "mimeType": "application/vnd.android.package-archive",
        "role": "Editor",
        "rank": "Default"
      }
    ],
    "shortDescription": "Run Android apps in their own Windows windows",
    "longDescription": "WINAPK installs its own Android runtime on first run, then installs each Android package and opens it in its own desktop window."
  }
}
